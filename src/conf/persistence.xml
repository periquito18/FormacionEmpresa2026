<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.1"
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
    https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">
    
    <persistence-unit name="FormacionEmpresa2026PU" transaction-type="RESOURCE_LOCAL">
        
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        
        <!-- Entidades -->
        <class>modelo.entidades.Profesor</class>
        <class>modelo.entidades.Curso</class>
        <class>modelo.entidades.Alumno</class>
        <class>modelo.entidades.Empresa</class>
        <class>modelo.entidades.Practica</class>
        
        <properties>
            <!-- Conexión a la base de datos -->
            <property name="jakarta.persistence.jdbc.driver" 
                      value="org.mariadb.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" 
                      value="jdbc:mariadb://localhost:3306/formacion2026"/>
            <property name="jakarta.persistence.jdbc.user" 
                      value="formacion2026"/>
            <property name="jakarta.persistence.jdbc.password" 
                      value="formacion2026"/>
            
            <!-- EclipseLink: muestra el SQL en consola (útil para depurar) -->
            <property name="eclipselink.logging.level" value="FINE"/>
            
            <!-- NO autogenera tablas, las creamos nosotros con el SQL -->
            <property name="eclipselink.ddl-generation" value="none"/>
        </properties>
        
    </persistence-unit>
</persistence>